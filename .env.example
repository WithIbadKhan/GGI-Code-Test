# ---------- Server ----------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Comma-separated list of browser origins allowed by CORS (no wildcards).
CORS_ORIGINS=http://localhost:5173
BODY_LIMIT=16kb
REQUEST_TIMEOUT_MS=30000
# Number of reverse proxies in front of the app (needed for correct per-IP rate limiting).
TRUST_PROXY_HOPS=0

# ---------- Database ----------
DATABASE_URL=postgres://ggi:ggi_local_password@localhost:5432/ggi
# Used only by `npm run test:integration`.
TEST_DATABASE_URL=postgres://ggi:ggi_local_password@localhost:5432/ggi_test

# ---------- Authentication (external OIDC provider, e.g. Auth0 / Keycloak) ----------
# For local development without Auth0, run `npm run dev:idp` and use:
#   AUTH_ISSUER=http://localhost:4000/
#   AUTH_JWKS_URI=http://localhost:4000/.well-known/jwks.json
AUTH_ISSUER=https://your-tenant.eu.auth0.com/
AUTH_AUDIENCE=https://api.ggi.local
AUTH_JWKS_URI=https://your-tenant.eu.auth0.com/.well-known/jwks.json
# Claim that holds the user's roles. Dotted paths are supported (e.g. realm_access.roles for Keycloak).
AUTH_ROLES_CLAIM=https://ggi.local/roles
# Client id of a Native/SPA application at the provider. Used only by `npm run api -- login`.
OIDC_CLIENT_ID=

# ---------- Request signing & sessions ----------
# Server secret from which each session's signing key is derived (min 32 chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SIGNING_SECRET=change-me-to-a-random-string-of-at-least-32-chars
SESSION_MAX_TTL_SECONDS=3600
# How far a signed request's X-Timestamp may be from the server clock.
SIGNATURE_MAX_SKEW_SECONDS=120
# Shared secret for monitoring systems calling GET /health (header X-Health-Token, min 24 chars).
HEALTH_CHECK_TOKEN=change-me-to-a-random-token

# ---------- AI provider ----------
# `mock` (default, required by the brief) or `gemini`.
AI_PROVIDER=mock
AI_TIMEOUT_MS=25000
MOCK_AI_MIN_LATENCY_MS=300
MOCK_AI_MAX_LATENCY_MS=1200
# Probability (0..1) that the mocked provider fails. Useful to see quota refunds in action.
MOCK_AI_FAILURE_RATE=0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ---------- Quota ----------
FREE_MESSAGES_PER_MONTH=3

# ---------- Subscriptions & billing ----------
# Probability (0..1) that a simulated payment is declined.
PAYMENT_FAILURE_RATE=0.1
# Background job that renews or expires subscriptions whose cycle has ended.
BILLING_JOB_ENABLED=true
BILLING_INTERVAL_MS=60000

# ---------- Rate limiting (per window; separate counters per route group) ----------
RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_PER_IP=60
CHAT_RATE_LIMIT_PER_USER=10
SUBSCRIPTION_RATE_LIMIT_PER_IP=60
SUBSCRIPTION_RATE_LIMIT_PER_USER=20
AUTH_RATE_LIMIT_PER_IP=20
AUTH_RATE_LIMIT_PER_USER=10
ADMIN_RATE_LIMIT_PER_IP=30
ADMIN_RATE_LIMIT_PER_USER=30
